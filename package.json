{
  "name": "weld_report",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d db",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:load": "node --env-file-if-exists=.env --import tsx scripts/load-weld-dump.ts",
    "lint:tokens": "node scripts/token-lint.mjs",
    "test:e2e": "playwright test",
    "db:seed:snapshot": "node --env-file-if-exists=.env --import tsx scripts/seed-weekly-snapshot.ts",
    "db:load:ut-ccc": "node --env-file-if-exists=.env --import tsx scripts/load-ut-tracker-ccc.ts",
    "db:load:exclusions": "node --env-file-if-exists=.env --import tsx scripts/load-exclusion-list.ts",
    "db:load:spool": "node --env-file-if-exists=.env --import tsx scripts/load-spool-dump.ts",
    "db:load:ccc-joints": "node --env-file-if-exists=.env --import tsx scripts/load-ccc-joint-record.ts",
    "db:load:ccc": "node --env-file-if-exists=.env --max-old-space-size=4096 --import tsx scripts/load-ccc-welder-record.ts"
  },
  "dependencies": {
    "chart.js": "4.5.1",
    "exceljs": "4.4.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "pg-copy-streams": "7.0.0",
    "react": "19.2.8",
    "react-chartjs-2": "5.3.1",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/pg-copy-streams": "1.2.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5",
    "vitest": "5.0.0"
  }
}
